# No dot-directories except github/vscode
.*/
!.vscode/
!.github/

*.code-workspace
node_modules
nbproject

# npm package files
iobroker.*.tgz

Thumbs.db

# Source maps are not shipped. build/ is intentionally tracked on main by CI.
*.map

# admin GUI sources and build output
src-admin/node_modules
src-admin/build

# admin/ is intentionally tracked on main by CI for installations from GitHub.

# i18n intermediate files
src-admin/src/i18n/flat.txt
src-admin/src/i18n/*/flat.txt

# release-script metadata
.commitinfo
