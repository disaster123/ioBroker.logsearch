{
  "name": "iobroker.logsearch",
  "version": "0.0.2",
  "description": "Search ioBroker log files by time range, level and text",
  "author": {
    "name": "Disaster123",
    "email": "stefan-iobroker@prie.be"
  },
  "homepage": "https://github.com/disaster123/ioBroker.logsearch",
  "license": "MIT",
  "keywords": [
    "log",
    "search",
    "full log search",
    "ui",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/disaster123/ioBroker.logsearch.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/adapter-react-v5": "^7.7.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@mui/material": "^6.4.8",
    "@mui/styles": "^6.4.8",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "@types/proxyquire": "^1.3.31",
    "@types/react": "^17.0.92",
    "@types/react-dom": "^17.0.26",
    "proxyquire": "^2.1.3",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typescript": "~5.9.3"
  },
  "main": "main.js",
  "files": [
    "!CHANGELOG_OLD.md",
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "admin/build/",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "prebuild": "rimraf admin/build",
    "build": "build-adapter react",
    "build:check": "npm run build && node scripts/check-admin-assets.js",
    "check:release": "node scripts/check-release.js",
    "watch": "build-adapter react --watch",
    "prebuild:react": "rimraf admin/build",
    "build:react": "build-adapter react",
    "watch:react": "build-adapter react --watch",
    "test:js": "npm exec --prefix node_modules/@iobroker/testing -- mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:unit": "npm run test:js",
    "test:package": "npm exec --prefix node_modules/@iobroker/testing -- mocha test/package --exit",
    "test:integration": "npm exec --prefix node_modules/@iobroker/testing -- mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/disaster123/ioBroker.logsearch/issues"
  },
  "readmeFilename": "README.md"
}
