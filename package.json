{
  "name": "iobroker.logsearch",
  "version": "0.0.4",
  "description": "Search ioBroker log files by time range, level and text",
  "author": {
    "name": "Disaster123",
    "email": "stefan-iobroker@prie.be"
  },
  "homepage": "https://github.com/disaster123/ioBroker.logsearch",
  "license": "MIT",
  "keywords": [
    "log",
    "search",
    "full log search",
    "ui",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/disaster123/ioBroker.logsearch.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@iobroker/types": "^7.2.2",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/sinon": "^22.0.0",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "mocha": "^12.0.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-admin && npm i",
    "build": "npm run build:ts && npm run build:gui",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:gui": "ts-node --project tsconfig.tasks.json tasks.ts",
    "0-clean": "ts-node --project tsconfig.tasks.json tasks.ts --0-clean",
    "1-npm": "ts-node --project tsconfig.tasks.json tasks.ts --1-npm",
    "2-build": "ts-node --project tsconfig.tasks.json tasks.ts --2-build",
    "3-copy": "ts-node --project tsconfig.tasks.json tasks.ts --3-copy",
    "4-patch": "ts-node --project tsconfig.tasks.json tasks.ts --4-patch",
    "prepublishOnly": "npm run build",
    "check:release": "node scripts/check-release.js",
    "test:ts": "cross-env TS_NODE_PROJECT=./tsconfig.test.json mocha --exit \"test/**/*.test.ts\"",
    "test:unit": "npm run test:ts",
    "test:package": "cross-env TS_NODE_PROJECT=./tsconfig.test.json mocha --exit test/package.ts",
    "test:integration": "cross-env TS_NODE_PROJECT=./tsconfig.test.json mocha --exit test/integration.ts",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint -c eslint.config.mjs",
    "lint-frontend": "cd src-admin && eslint -c eslint.config.mjs",
    "translate": "translate-adapter -b src-admin/src/i18n/en.json",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/disaster123/ioBroker.logsearch/issues"
  },
  "readmeFilename": "README.md"
}
